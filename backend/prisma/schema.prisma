generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Director {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  dob         DateTime
  biography   String
  nationality String
  imagePath   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById Int?
  createdBy   User?    @relation("DirectorCreator", fields: [createdById], references: [id])
  movies      Movie[]
}

model Actor {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  dob         DateTime
  nationality String
  awards      Int
  biography   String
  gender      String
  imagePath   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById Int?
  createdBy   User?    @relation("ActorCreator", fields: [createdById], references: [id])
  movies      Movie[]  @relation("ActorToMovie")
}

model Movie {
  id           Int                @id @default(autoincrement())
  title        String
  duration     Int
  genre        String
  rating       Int
  directorId   Int
  description  String
  language     String
  releaseDate  DateTime
  trailerId    String
  posterPath   String?
  bannerPath    String?     
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt
  createdById  Int?
  createdBy    User?              @relation("MovieCreator", fields: [createdById], references: [id])
  director     Director           @relation(fields: [directorId], references: [id])
  interactions MovieInteraction[]
  reviews      Review[]
  actors       Actor[]            @relation("ActorToMovie")
}

model User {
  id               Int                @id @default(autoincrement())
  username         String             @unique
  email            String             @unique
  password         String
  firstName        String
  lastName         String
  role             Role               @default(VIEWER)
  ISActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt
  createdActors    Actor[]            @relation("ActorCreator")
  createdDirectors Director[]         @relation("DirectorCreator")
  createdMovies    Movie[]            @relation("MovieCreator")
  interactions     MovieInteraction[]
  reviews          Review[]
}

model MovieInteraction {
  id        Int             @id @default(autoincrement())
  userId    Int
  movieId   Int
  type      InteractionType
  createdAt DateTime        @default(now())
  movie     Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId, type])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  userId    Int
  movieId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum InteractionType {
  FAVORITE
  WATCHLIST
}
